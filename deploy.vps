#!/usr/bin/env bash
set -e

echo "=== Starting Full VPS Deployment for Mirror-Leech Bot ==="

# Check root privileges
if [ "$EUID" -ne 0 ]; then
  echo "[-] Please run as root or with sudo."
  exit 1
fi

APP_DIR=$(pwd)
SERVICE_NAME="wzml_bot"

echo "[1/6] Updating system and installing system dependencies..."
export DEBIAN_FRONTEND=noninteractive
apt-get update -qq
apt-get install -y -qq \
    python3 \
    python3-pip \
    python3-venv \
    python3-dev \
    build-essential \
    libmagic1 \
    libmagic-dev \
    libffi-dev \
    libssl-dev \
    ffmpeg \
    p7zip-full \
    p7zip-rar \
    par2 \
    aria2 \
    rclone \
    qbittorrent-nox \
    git \
    curl \
    wget \
    lsof \
    procps \
    cpulimit \
    sabnzbdplus

echo "[2/6] Setting up Python virtual environment..."
if [ ! -d "venv" ]; then
    python3 -m venv venv
fi

source venv/bin/activate
pip install --upgrade pip -q
pip install wzgram
if [ -f "requirements.txt" ]; then
    pip install -r requirements.txt -q
fi

echo "[3/6] Preparing required directories..."
mkdir -p downloads thumbnails tokens rclone cookies Images

echo "[4/6] Configuring systemd service..."
PYTHON_EXEC="$APP_DIR/venv/bin/python3"

cat <<EOF > /etc/systemd/system/${SERVICE_NAME}.service
[Unit]
Description=WZML Mirror Leech Bot Service
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=root
WorkingDirectory=$APP_DIR
ExecStart=$PYTHON_EXEC -m bot
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
EOF

echo "[5/6] Reloading systemd daemon and enabling service..."
systemctl daemon-reload
systemctl enable ${SERVICE_NAME}.service

echo "[6/6] Starting application service..."
systemctl restart ${SERVICE_NAME}.service

echo "=== VPS Deployment Complete! ==="
echo "Service Name: ${SERVICE_NAME}"
echo "Status Check: systemctl status ${SERVICE_NAME}"
echo "View Logs:    journalctl -u ${SERVICE_NAME} -f"
